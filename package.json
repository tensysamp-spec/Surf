{
  "name": "browser",
  "version": "1.0.0",
  "description": "A desktop web browser for macOS",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/",
    "start": "electron .",
    "package": "electron-builder --mac --dir && codesign --force --deep --sign - dist/mac*/Surf.app",
    "package:universal": "electron-builder --mac dir --universal && codesign --force --deep --sign - dist/mac-universal/Surf.app",
    "release": "electron-builder --mac --config build/release.config.js --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@mozilla/readability": "^0.6.0",
    "electron-chrome-web-store": "^0.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438"
  },
  "productName": "Surf",
  "build": {
    "appId": "app.browser.desktop",
    "productName": "Surf",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!server/**",
      "!*.md",
      "!build/icon.svg",
      "!build/release.config.js",
      "!build/entitlements.mac.plist",
      "!docs/**",
      "!release/**",
      "!node_modules/pdfjs-dist/{legacy,types,image_decoders}/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "!node_modules/pdf-lib/{dist,es,src,ts3.4}/**"
    ],
    "protocols": [
      {
        "name": "Web page",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": "dir",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.html"
            ]
          }
        ]
      },
      "icon": "build/icon.icns"
    }
  }
}
