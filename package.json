{
  "name": "browser",
  "version": "1.0.0",
  "description": "A desktop web browser for macOS",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/",
    "start": "electron .",
    "package": "electron-builder --mac --dir && codesign --force --deep --sign - dist/mac*/Surf.app"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@mozilla/readability": "^0.6.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "productName": "Surf",
  "build": {
    "appId": "app.browser.desktop",
    "productName": "Surf",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!server/**",
      "!*.md",
      "!build/icon.svg"
    ],
    "fileAssociations": [
      {
        "ext": "surfspace",
        "name": "Surf Space",
        "description": "A Surf space (pinned tabs and folders)",
        "role": "Viewer",
        "rank": "Owner"
      }
    ],
    "protocols": [
      {
        "name": "Web page",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": "dir",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": [
              "public.html"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "app.browser.desktop.surfspace",
            "UTTypeDescription": "Surf Space",
            "UTTypeConformsTo": [
              "public.json"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "surfspace"
              ]
            }
          }
        ]
      },
      "icon": "build/icon.icns"
    }
  }
}
